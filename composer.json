{
    "name": "robuust/craft-hzt",
    "description": "Huisartsenzorg Twente integration for Craft CMS",
    "type": "craft-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "Robuust",
            "homepage": "https://robuust.digital"
        }
    ],
    "support": {
        "issues": "https://github.com/robuust/craft-hzt/issues",
        "source": "https://github.com/robuust/craft-hzt"
    },
    "extra": {
        "handle": "hzt",
        "name": "HZT",
        "developer": "Robuust",
        "developerUrl": "https://robuust.digital",
        "hasCpSettings": false,
        "hasCpSection": false,
        "class": "robuust\\hzt\\Plugin"
    },
    "require": {
        "php": "^8.2",
        "craftcms/cms": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "robuust\\hzt\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true,
            "craftcms/plugin-installer": true
        }
    }
}
